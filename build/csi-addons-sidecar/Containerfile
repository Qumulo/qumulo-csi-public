# csi-addons k8s-sidecar, rebuilt from upstream source with its CVE fixes.
#
# Why this exists: the chart's replication sidecar, quay.io/csiaddons/
# k8s-sidecar:v0.15.1 (the latest upstream release, 2026-11-23), carries 12
# fixable HIGH findings -- Go stdlib 1.26.8 (fixed in 1.26.10) and
# golang.org/x/net v0.58.0 (fixed in v0.62.0), each in both of its binaries.
# Disaster recovery cannot be labelled supported on an image the CVE gate
# holds under an exception (DR graduation plan, B4 / D4: "wait for upstream,
# own build as fallback"). This is that fallback.
#
# What changes from upstream, and nothing else:
#   - the Go toolchain: our pinned golang:1.27.4 instead of 1.26.8;
#   - golang.org/x/net bumped to v0.62.0 (go mod tidy + vendor follow it);
#   - the runtime base: UBI micro, like the driver's own images, instead of
#     distroless, for OpenShift certification's BasedOnUbi check.
# The sidecar's code is upstream's, at the commit of the v0.15.1 tag, checked
# out by hash so a moved tag cannot change what is built.
#
# Switch back to the official image at the first upstream release with no
# fixable HIGH/CRITICAL finding, and delete this directory.
#
# Build through the Makefile: make csi-addons-sidecar-build

# ---- source and build -------------------------------------------------------
FROM --platform=$BUILDPLATFORM golang:1.27.4@sha256:205c7636d74e0ffbe3d007162df7d74f859f5a8c8322dfb9f907977686c126cf AS build

ARG TARGETOS
ARG TARGETARCH
ARG CSI_ADDONS_TAG=v0.15.1
ARG CSI_ADDONS_COMMIT=f7f0778d4f532ebfdbade80b693b0c8161520e9c
ARG XNET_VERSION=v0.62.0

# The build context is upstream's tree at CSI_ADDONS_COMMIT, fetched and
# checked by hash on the build host (make csi-addons-sidecar-src). Not the Go
# module proxy's copy: the proxy's v0.15.1 is bb97e8d, cached before upstream
# moved the tag on 2026-09-21 to f7f0778d -- and the published image was built
# from f7f0778d, 33 minutes after that commit.
WORKDIR /src
COPY . .
RUN test "$(git rev-parse HEAD)" = "$CSI_ADDONS_COMMIT" \
 && test "$(cat .qumulo-source-commit)" = "$CSI_ADDONS_COMMIT"

# The CVE fix: one library, then let the module graph and vendor/ follow.
RUN go get "golang.org/x/net@${XNET_VERSION}" \
 && go mod tidy \
 && go mod vendor \
 && go list -m golang.org/x/net | grep -q " ${XNET_VERSION}$"

# Same version stamps as upstream's Makefile, plus our usual hardening.
RUN set -e; \
    pkg=github.com/csi-addons/kubernetes-csi-addons/internal/version; \
    ld="-s -w -X ${pkg}.GitCommit=${CSI_ADDONS_COMMIT} -X ${pkg}.Version=${CSI_ADDONS_TAG}"; \
    for target in sidecar/main.go:csi-addons-sidecar ./cmd/csi-addons:csi-addons; do \
      CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
        go build -mod=vendor -buildvcs=false -trimpath -ldflags "$ld" -o "/out/${target#*:}" "${target%%:*}"; \
    done

# ---- runtime ----------------------------------------------------------------
FROM registry.access.redhat.com/ubi9/ubi-micro:9.9-1794478307@sha256:dbd325b96bcd432dd42816d31412bdf1dc0fb973b79ed310344bc23c76c068db AS ubi-micro

FROM registry.access.redhat.com/ubi9/ubi:9.9-1795197514@sha256:6636b79fba9e5044360366f189333c30b5ce528efd92c40c68b074592b971fcd AS rootfs
COPY --from=ubi-micro / /mnt/rootfs
RUN dnf upgrade -y --installroot /mnt/rootfs --releasever 9 \
      --setopt install_weak_deps=false --nodocs \
 && dnf --installroot /mnt/rootfs clean all \
 && rm -rf /mnt/rootfs/var/cache/* /mnt/rootfs/var/log/dnf* /mnt/rootfs/var/log/hawkey.log

FROM ubi-micro AS sidecar
COPY --from=rootfs /mnt/rootfs/ /
COPY --from=build /src/LICENSE /licenses/LICENSE
COPY --from=build /out/csi-addons-sidecar /usr/sbin/csi-addons-sidecar
COPY --from=build /out/csi-addons /usr/bin/csi-addons

ARG CSI_ADDONS_TAG=v0.15.1
ARG CSI_ADDONS_COMMIT=f7f0778d4f532ebfdbade80b693b0c8161520e9c
LABEL name="qumulo-csi-addons-k8s-sidecar" \
      vendor="Qumulo, Inc." \
      version="${CSI_ADDONS_TAG}-qumulo.1" \
      summary="csi-addons k8s-sidecar, rebuilt from upstream with CVE fixes" \
      description="Upstream csi-addons k8s-sidecar ${CSI_ADDONS_TAG} (${CSI_ADDONS_COMMIT}) rebuilt with Go 1.27.4 and golang.org/x/net v0.62.0 on UBI 9 micro." \
      io.k8s.display-name="csi-addons k8s-sidecar (Qumulo rebuild)" \
      org.opencontainers.image.source="https://github.com/csi-addons/kubernetes-csi-addons" \
      org.opencontainers.image.revision="${CSI_ADDONS_COMMIT}" \
      org.opencontainers.image.licenses="Apache-2.0"

USER 65532:65532
ENTRYPOINT ["/usr/sbin/csi-addons-sidecar"]
