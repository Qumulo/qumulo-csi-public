# Copy to live.env (next to these scripts) and fill in. Sourced by common.sh.
KUBECONFIG=~/.kube/config
KUBE_CONTEXT=ocp-csi-test           # the scripts refuse any other context
RUN_DIR=~/run-ocp-live              # evidence: <RUN_DIR>/<check>/{log.txt,verdicts.txt,...}
CHART=~/qumulo-csi-driver/charts/qumulo-csi-driver   # the chart under test
OLD_CHART=~/qcsi-old/charts/qumulo-csi-driver        # a chart from before OpenShift support (upgrade check)
BASE_CHART=                          # optional: a chart expected to FAIL the --reuse-values upgrade (I-1 before the fix)
REGISTRY=10.0.1.4:5000              # where the driver images are
TAG=0.1.0-<commit>                  # image tag under test
OLD_TAG=0.1.0-<old commit>          # image tag for OLD_CHART
DRIVER_NS=qumulo-csi                # the installed release's namespace (perms check)
DRIVER_RELEASE=qumulo-csi
ARRAY=10.0.0.13                     # Qumulo array the fresh install provisions on
API_URL=https://10.0.0.13:8000
TOKEN_SECRET=qumulo-api-token       # Secret in DRIVER_NS, copied into the fresh install's namespace
BASE_PATH=/csi-ocp/volumes          # store path on the array
ALLOWED_CLIENTS=10.0.3.0/24,10.0.4.0/24
APP_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.5
MATRIX_CLASSES=nfs41=qumulo-nfs41,nfs3=qumulo-nfs3   # existing dedicated-export classes the matrix copies

# --- storage outage checks (storage_outage.py, storage_outage_poweroff.py) ---
SPARE_FLOATING_IP=10.0.0.19         # an array address NOTHING else on the cluster mounts; storage_outage.py
                                    # blackholes TCP 2049 to it on one worker and refuses if that worker
                                    # already mounts it
OUTAGE_GRACE_S=120                  # the workload pods' terminationGracePeriodSeconds -- and the pass bar:
                                    # the ladder has to finish inside it
OUTAGE_S=600                        # how long the blackhole lasts (the rule removes itself after this)
OUTAGE_BASELINE_S=120               # quiet sampling before the fault
OUTAGE_RECOVER_S=300                # sampling after the fault lifts, for the return-to-baseline checks
DEBUG_IMAGE=registry.access.redhat.com/ubi9/ubi-minimal:9.5   # image for `oc debug node`
# OUTAGE_ASSUME_YES=1               # power-off check only: skip the operator prompts (automated lab power)

# --- node lifecycle checks (node_add_remove.py, node_loss.py, node_reboot.py, controller_disruption.py, mcp_roll.py) ---
NL_MACHINESET=csi-test-xxxxx-worker-centralindia3   # a worker MachineSet the add/remove and loss checks scale up by
                                    # one and back; they remove only the Machine they added
NL_CLASSES=nfs41=qumulo-nfs41,nfs3=qumulo-nfs3      # RWX claims on the nfs41 class, RWO on the nfs3 class; both must
                                    # allow the subnet a new worker lands in and give a 0777 folder (I-12)
NL_REBOOT_NODE=                     # node_reboot.py: the worker to reboot (default: the first worker)
NL_REBOOT_MODES=graceful,hard       # node_reboot.py: graceful = systemctl reboot, hard = reboot --force --force
NL_MASTER_REBOOT=1                  # controller_disruption.py: 0 skips the control-plane reboot (NL-08)
NL_MASTER=                          # ...and which master (default: the first)
NL_OUT_OF_SERVICE=1                 # node_loss.py: apply node.kubernetes.io/out-of-service after NotReady
NL_MCP=worker                       # mcp_roll.py: the pool to roll; it also needs NL_ALLOW_MCP_ROLL=1
# Bars, in seconds. Defaults measured on a lab cluster (a new worker joins in about 270 s).
NL_NODE_JOIN_S=1500                 # MachineSet +1 to a Ready node
NL_PLUGIN_READY_S=300               # node Ready to node plugin Ready
NL_RESCHEDULE_S=300                 # drain start to the moved writer Ready elsewhere
NL_UNMOUNT_S=60                     # pod gone to no mount of its volume on the drained node
NL_REBOOT_READY_S=900               # reboot to a new bootID and Ready
NL_RESUME_S=180                     # node Ready again to its pinned writers Ready again
NL_LOSS_RESUME_S=600                # out-of-service taint to the replacement writer Ready
NL_STALL_S=30                       # longest pause a writer on an undisturbed node may show
NL_LEADER_S=120                     # leader's node rebooted to a new csi-provisioner lease holder
NL_DRAIN_S=900                      # `oc adm drain --timeout`
NL_MCP_GAP_S=300                    # longest writer stop during a MachineConfigPool roll
NL_REF_MB=64                        # size of each writer's checksummed reference file

# --- disaster recovery after a failover (dr_failover.py) ---
# Needs two Qumulo arrays, the csi-addons sidecar, and a build with the multi-network replica export fix.
DR_CLASS=qumulo-dns                 # the StorageClass the protected claim uses, on the source array. It must name
                                    # at least TWO networks in allowedClients, or DR-01 is not a real gate
DR_APP_NODE=                        # the worker the post-failover writer runs on. It must sit on a network that is
                                    # NOT the first entry of DR_CLASS's allowedClients; empty means "any worker",
                                    # which the check reports as not a real gate
DR_VRC_AB=qumulo-c1-to-c2           # VolumeReplicationClass, source array -> peer
DR_VRC_BA=qumulo-c2-to-c1           # ...and back, for the end on the peer
DR_PEER_SERVER=10.0.0.23            # the peer array (the DR copy lands here)
DR_PEER_API_URL=https://10.0.0.23:8000
DR_PEER_TOKEN_FILE=~/.qumulo/dr-token   # a file holding the peer array's API token, for qumulo-csi-repoint mirror
DR_PEER_SECRET=qumulo-tokens-dr     # Secret in DRIVER_NS the mirrored PV names for its deletion credential
DR_REPOINT=go run ./cmd/qumulo-csi-repoint   # or the path to a built qumulo-csi-repoint binary
DR_REPO=                            # repo root `DR_REPOINT` runs from (default: three levels above these scripts)
# Bars, in seconds.
DR_SYNC_S=600                       # Enable to Primary with a lastSyncTime
DR_PROMOTE_S=300                    # each VolumeReplication state change
DR_MOUNT_S=300                      # promoted claim to a Ready writer on it
DR_RTO_S=600                        # DR-02: longest stop the application may show across the failover
DR_WRITE_S=90                       # how long each incarnation writes before it is judged
