# Performance validation configuration. Copy to performance.env (git-ignored) and fill in, or point PERF_CONFIG at a file.
#   cp performance.env.example performance.env && chmod 600 performance.env
# The array keys are the resource report's (test/resource-report/resource-report.env.example), plus LIVE_ARRAYS,
# NODE_ARRAYS and further arrays C, D, ...; relative paths are relative to test/resource-report/.
# Tokens never go here: only the path to a file holding one (raw bearer
# token or the JSON login response), chmod 600, outside git.

# ---- Array A -------------------------------------------------------------------------------------------------------
ARRAY_A_SERVER=<array-A NFS address>
ARRAY_A_API=https://<array-A REST address>:8000
ARRAY_A_TOKEN_FILE=<path to array-A admin token file>
# Store path the live tests and the binary tier create volumes in. MUST already exist, MUST contain "csi-live-test"
# (the live harness refuses anything else, because it tree-deletes what it creates), and an export must cover it.
ARRAY_A_SHARED_REAL=<e.g. /csi-live-test/volumes>
ARRAY_A_SHARED_EXPORT=<NFS path of the same directory>
# Existing directory for dedicated-export volumes (binary tier only).
ARRAY_A_DEDICATED_REAL=<e.g. /csi-dedicated>
ARRAY_A_DEDICATED_EXPORT=<e.g. /csi-dedicated>
# Optional: a token on a least-privilege role (live-replication-guards uses it; those tests skip without it).
ARRAY_A_LOWPRIV_TOKEN_FILE=

# ---- Array B -------------------------------------------------------------------------------------------------------
ARRAY_B_SERVER=<array-B NFS address>
ARRAY_B_API=https://<array-B REST address>:8000
ARRAY_B_TOKEN_FILE=<path to array-B admin token file>
ARRAY_B_SHARED_REAL=<e.g. /csi-live-test/volumes>
ARRAY_B_SHARED_EXPORT=<NFS path of the same directory>
ARRAY_B_DEDICATED_REAL=<e.g. /csi-dedicated>
ARRAY_B_DEDICATED_EXPORT=<e.g. /csi-dedicated>

# ---- Optional: more arrays, C, D, ... ------------------------------------------------------------------------------
# Same seven keys per letter. Use them for other node addresses of the two clusters, to run the per-array live tests
# and the mounts through every node (A and B must stay two different clusters: the binary tier and replication use
# them). `./run.sh check` prints which cluster each letter reaches. Add the letters to LIVE_ARRAYS / NODE_ARRAYS.
# ARRAY_C_SERVER=<node address>
# ARRAY_C_API=https://<node address>:8000
# ARRAY_C_TOKEN_FILE=<path to a token file for that cluster>
# ARRAY_C_SHARED_REAL=... ARRAY_C_SHARED_EXPORT=... ARRAY_C_DEDICATED_REAL=... ARRAY_C_DEDICATED_EXPORT=...

# ---- Which arrays run what -----------------------------------------------------------------------------------------
# Arrays the per-array live cases run against (comma-separated), e.g. A,B,C,D.
LIVE_ARRAYS=A,B
# Arrays the NFS mount cases (live-node) run against. Leave out an array that cannot serve mounts from this host.
NODE_ARRAYS=B
# Replication cases run with LOCAL=A and PEER=B; the two clusters must be able to replicate to each other.

# ---- Node process / mounts -----------------------------------------------------------------------------------------
# docker: run mount tests in NODE_IMAGE (needs only its NFS userland); host: run them on this machine (needs nfs-common).
NODE_RUNTIME=docker
NODE_IMAGE=qumulo-csi-driver-node:0.1.0

# ---- Run -----------------------------------------------------------------------------------------------------------
NAME_PREFIX=csi-rcr            # objects the binary tier creates (via test/resource-report)
OUT_DIR=runs                   # one sub-folder per run
