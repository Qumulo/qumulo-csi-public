# Resource Consumption Report configuration. Copy to resource-report.env (git-ignored) and fill in.
#   cp resource-report.env.example resource-report.env && chmod 600 resource-report.env
# Format: KEY=value, one per line. Environment variables of the same name override this file.
# Relative paths are relative to this folder (test/resource-report/).
# Tokens never go in this file: only the path to a file holding one. The file may hold the raw bearer token or the
# JSON login response ({"bearer_token": "..."}). Keep token files chmod 600 and out of git.

# ---- Array A -------------------------------------------------------------------------------------------------------
ARRAY_A_SERVER=<array-A NFS address>                      # NFS server address (StorageClass `server`)
ARRAY_A_API=https://<array-A REST address>:8000            # REST URL (StorageClass `apiUrl`)
ARRAY_A_TOKEN_FILE=<path to array-A token file>               # admin-class token for array A
# Existing directories the run may create volumes in (CreateVolume needs the store root to exist) and the NFS path
# they are seen through. The shared path must be covered by an export; dedicated-export creates its own exports.
ARRAY_A_SHARED_REAL=/root/csi-live-test/volumes
ARRAY_A_SHARED_EXPORT=/qumulo-nfs41-csi/csi-live-test/volumes
ARRAY_A_DEDICATED_REAL=/csi-dedicated
ARRAY_A_DEDICATED_EXPORT=/csi-dedicated

# ---- Array B -------------------------------------------------------------------------------------------------------
ARRAY_B_SERVER=<array-B NFS address>
ARRAY_B_API=https://<array-B REST address>:8000
ARRAY_B_TOKEN_FILE=<path to array-B token file>
ARRAY_B_SHARED_REAL=/csi-live-test/volumes
ARRAY_B_SHARED_EXPORT=/csi-live-test/volumes
ARRAY_B_DEDICATED_REAL=/csi-dedicated
ARRAY_B_DEDICATED_EXPORT=/csi-dedicated

# ---- Node process --------------------------------------------------------------------------------------------------
# docker: run the node process in NODE_IMAGE (needs only its NFS userland; the freshly built binary is bind-mounted in).
# host:   run it directly on this machine (needs nfs-common / mount.nfs installed).
NODE_RUNTIME=docker
NODE_IMAGE=qumulo-csi-driver-node:0.1.0            # `make docker-build-node` from the repo root builds it

# ---- Run -----------------------------------------------------------------------------------------------------------
NAME_PREFIX=csi-rcr                                # every object the run creates starts with this; cleanup keys on it
OUT_DIR=runs                                       # one sub-folder per run
CONTROLLER_METRICS_PORT=29654
NODE_METRICS_PORT=29655
